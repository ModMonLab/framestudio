{
  "schemaVersion": 1,
  "name": "Frame bundled library",
  "defaults": {
    "output": {
      "preset": "out.landscape-hd@1",
      "width": 1920,
      "height": 1080,
      "aspectRatios": [
        "16:9",
        "9:16",
        "1:1"
      ]
    },
    "frameRate": 24,
    "styleFamily": "flat",
    "captionStyle": "txt.podcast-captions@1",
    "previewCharacter": "chr.maya-bennett@1",
    "previewHair": "hair.straight-long@1",
    "builderTests": {
      "expressions": [
        "exp.smile@1",
        "exp.surprised@1",
        "exp.sad@1",
        "exp.skeptical@1",
        "exp.embarrassed@1",
        "exp.angry@1"
      ],
      "gestures": [
        "act.calm-talk@1",
        "act.point-at@1",
        "act.wave-hello@1"
      ],
      "lipSyncText": "Hello, this is a lip sync test."
    },
    "coverage": {
      "wide": "cam.wide@1",
      "single": "cam.medium-close-up@1",
      "two": "cam.two-shot@1"
    },
    "timeOfDay": [
      {
        "id": "day",
        "name": "Day",
        "tint": "#FFF6E0",
        "amount": 0,
        "darken": 0,
        "atmosphere": "atmo.day@1"
      },
      {
        "id": "golden-hour",
        "name": "Golden hour",
        "tint": "#FFB36B",
        "amount": 0.16,
        "darken": 0.04,
        "atmosphere": "atmo.golden-hour@1"
      },
      {
        "id": "dusk",
        "name": "Dusk",
        "tint": "#8A5FA8",
        "amount": 0.2,
        "darken": 0.22,
        "atmosphere": "atmo.dusk@1"
      },
      {
        "id": "night",
        "name": "Night",
        "tint": "#24365F",
        "amount": 0.32,
        "darken": 0.48,
        "atmosphere": "atmo.night@1"
      }
    ],
    "accessoryGesture": "act.wave-hello@1"
  }
}
