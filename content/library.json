{
  "schemaVersion": 1,
  "name": "Frame bundled library",
  "defaults": {
    "output": {
      "preset": "out.landscape-hd@1",
      "width": 1920,
      "height": 1080,
      "aspectRatios": [
        "16:9",
        "9:16",
        "1:1"
      ]
    },
    "frameRate": 24,
    "styleFamily": "flat",
    "captionStyle": "txt.podcast-captions@1",
    "previewCharacter": "chr.maya-bennett@1",
    "builderTests": {
      "expressions": [
        "exp.smile@1",
        "exp.surprised@1",
        "exp.sad@1",
        "exp.skeptical@1",
        "exp.embarrassed@1",
        "exp.angry@1"
      ],
      "gestures": [
        "act.calm-talk@1",
        "act.point-at@1",
        "act.wave-hello@1"
      ],
      "lipSyncText": "Hello, this is a lip sync test."
    }
  }
}
