{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frame.local/schema/history.json",
  "additionalProperties": false,
  "type": "object",
  "properties": {
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "at": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "name": {
            "pattern": "^[a-z]+(\\.[a-z][a-zA-Z]*)+$",
            "description": "Command name, e.g. scene.add, clip.move.",
            "type": "string"
          },
          "params": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {}
            }
          }
        },
        "required": [
          "name",
          "params"
        ]
      }
    }
  },
  "required": [
    "revision",
    "at",
    "label",
    "source",
    "commands"
  ]
}
