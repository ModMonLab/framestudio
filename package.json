{
  "name": "frame-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "frame": "tsx packages/cli/src/bin.ts",
    "catalog:doc": "tsx tools/catalog/generate-doc.ts",
    "tokens:gen": "tsx packages/design-tokens/src/generate.ts",
    "test:visual": "pnpm --filter @frame/gallery exec playwright test",
    "content:build": "tsx tools/content/build.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@frame/assets": "workspace:*",
    "@frame/cli": "workspace:*",
    "@frame/core": "workspace:*",
    "@frame/design-tokens": "workspace:*",
    "@frame/io": "workspace:*",
    "@frame/render": "workspace:*",
    "@frame/rig": "workspace:*",
    "@frame/schema": "workspace:*",
    "@frame/server": "workspace:*",
    "@frame/voice-client": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
